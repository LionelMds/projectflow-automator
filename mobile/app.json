{
  "expo": {
    "name": "ProjectFlow",
    "slug": "projectflow",
    "version": "0.1.0",
    "scheme": "projectflow",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/ed47a3cf-6583-4ec0-86f3-2b79152aaed2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.balzmetal.projectflow",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ch.balzmetal.projectflow",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F3"
        }
      ],
      [
        "./plugins/withWidgetsIos17",
        {
          "widgets": [
            {
              "name": "PlanningJour",
              "displayName": "Planning",
              "description": "La journée de vos personnes, d’après le planning partagé.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "./src/widgets/PlanningJour.tsx",
                "configuration": {
                  "title": "Planning",
                  "description": "Moi, Ma sélection (cochée dans Paramètres de ProjectFlow), une équipe, une personne ou tout le monde.",
                  "parameters": {
                    "afficher": {
                      "title": "Afficher",
                      "type": "enum",
                      "dynamic": true,
                      "default": "moi",
                      "values": [
                        { "name": "Moi", "value": "moi" },
                        { "name": "Ma sélection", "value": "selection" },
                        { "name": "Tout le monde", "value": "tous" }
                      ]
                    }
                  }
                }
              },
              "android": null
            },
            {
              "name": "DossiersRecents",
              "displayName": "Dossiers récents",
              "description": "Les derniers dossiers ouverts sur ce téléphone.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular"
                ],
                "initialLayout": "./src/widgets/DossiersRecents.tsx"
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ed47a3cf-6583-4ec0-86f3-2b79152aaed2"
      }
    },
    "owner": "lionel.mds"
  }
}
